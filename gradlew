#!/bin/sh
# Placeholder gradle wrapper script.
#
# To materialise a real wrapper, run once with a system-installed Gradle:
#     gradle wrapper --gradle-version 8.7
#
# This will replace gradlew, gradlew.bat, and gradle/wrapper/gradle-wrapper.jar
# with the proper Gradle-shipped versions. The
# gradle/wrapper/gradle-wrapper.properties file already points at Gradle 8.7
# so the wrapper command above will use the right version.

echo "gradlew is a placeholder."
echo "Please run: gradle wrapper --gradle-version 8.7"
exit 1
